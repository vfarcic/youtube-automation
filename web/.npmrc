# npm 12 changed the default of `allow-remote` from `all` to `none`, which makes
# npm refuse to fetch tarballs it classifies as "remote". `@tailwindcss/oxide`
# pulls in the optional `@tailwindcss/oxide-wasm32-wasi` fallback, which declares
# `bundleDependencies`, so npm must download and unpack its tarball to re-resolve
# the tree. Under npm 12 that aborts with EALLOWREMOTE, which broke Renovate's
# lockfile updates (it runs npm 12) and left package.json/package-lock.json out
# of sync, failing `npm ci` in CI.
#
# `all` is the narrowest escape hatch npm offers: the only values are
# all / none / root, and `root` does not cover transitive dependencies.
# This restores the npm 11 behaviour.
allow-remote=all
